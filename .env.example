# ─────────────────────────────────────────────────────────────────────────────
# Production compose environment. Copy to .env and fill in real values.
# NEVER commit .env to Git. NEVER bake these into images.
# ─────────────────────────────────────────────────────────────────────────────

# ── Images / build metadata ───────────────────────────────────────────────────
APP_VERSION=2.0.0
GIT_SHA=unknown
BACKEND_IMAGE=imigrasi-backend:2.0.0
FRONTEND_IMAGE=imigrasi-frontend:2.0.0
WEB_CONCURRENCY=2

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=imigrasi_db
DB_USER=imigrasi_user
DB_PASSWORD=GANTI_PASSWORD_DB_KUAT
DB_ROOT_PASSWORD=GANTI_PASSWORD_ROOT_KUAT

# ── Security ──────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=GANTI_DENGAN_RANDOM_64_HEX
JWT_ISSUER=imigrasi-api
JWT_AUDIENCE=imigrasi-web
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=1

# Domain publik (wajib, tanpa wildcard). Bisa juga format JSON: ["https://domain"]
ALLOWED_ORIGINS=https://domain-anda.com
COOKIE_DOMAIN=

# ── Rate limiting / logging ───────────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOG_LEVEL=INFO
LOG_FORMAT=json
SSE_ENABLED=true
