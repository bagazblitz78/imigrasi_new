# ─────────────────────────────────────────────────────────────────────────────
# Salin ke .env lalu isi nilai aslinya:  cp .env.example .env
# JANGAN pernah commit file .env ke Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development           # development | staging | production
APP_NAME=Sistem Imigrasi API
APP_VERSION=dev               # di-set otomatis saat build image (git SHA / tag)
API_BASE_URL=

# ── Database (MariaDB/MySQL) ──────────────────────────────────────────────────
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=imigrasi_db
DB_USER=imigrasi_user
DB_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT
# Buat MariaDB yang mendukung TLS (opsional, disarankan di production):
DB_SSL=false

# ── JWT / Session ─────────────────────────────────────────────────────────────
# WAJIB diganti di production. Generate:  openssl rand -hex 32
JWT_SECRET=GANTI_DENGAN_RANDOM_64_HEX
JWT_ALGORITHM=HS256
JWT_ISSUER=imigrasi-api
JWT_AUDIENCE=imigrasi-web
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=1

# ── Cookie / CSRF ─────────────────────────────────────────────────────────────
# COOKIE_SECURE harus true di production (HTTPS).
COOKIE_SECURE=false
COOKIE_DOMAIN=
CSRF_HEADER=X-CSRF-Token

# ── CORS (JANGAN pakai "*" kalau allow_credentials aktif) ─────────────────────
ALLOWED_ORIGINS=https://domain-anda.com
# Format alternatif JSON juga diterima: ["https://domain-anda.com"]

# ── Login rate limiting (DB-backed, dishare antar worker) ─────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900

# ── Upload / MRZ ──────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE=8388608       # 8 MB
MRZ_PROCESSING_TIMEOUT=30

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=plain              # plain | json
SSE_ENABLED=true
