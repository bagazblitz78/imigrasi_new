# ─────────────────────────────────────────────────────────────────────────────
# Semua variabel VITE_* akan TERTANAM di bundle frontend dan bersifat PUBLIK.
# JANGAN pernah menaruh secret, kredensial database, atau API key privat di sini.
# ─────────────────────────────────────────────────────────────────────────────
# Path API relatif (default). Ubah hanya jika API berada di origin lain.
VITE_API_BASE=/imigrasi/api/v1

# Mode demo/offline (data statis, tanpa backend). Untuk mencoba UI saja.
# Aktifkan lewat: npm run dev:mock  (memakai .env.mock)
VITE_USE_MOCK=false
